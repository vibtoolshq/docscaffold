---
import { existsSync } from "node:fs";
import { relative, resolve } from "node:path";
import { ArrowUpRight, BookOpen, Search } from "lucide-astro";
import siteConfig from "../../config/site.config.json";
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";

interface Props {
  site?: typeof siteConfig;
  projects?: Array<{ slug: string; title: string }>;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { site = siteConfig, projects = [], robots, structuredData } = Astro.props;
const publicRoot = resolve(process.cwd(), "public");
const logoPath = resolve(publicRoot, site.brandLogo.replace(/^\/+/, ""));
const logoRelativePath = relative(publicRoot, logoPath);
const brandLogoExists =
  site.brandLogo.startsWith("/") &&
  logoRelativePath !== ".." &&
  !logoRelativePath.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`) &&
  existsSync(logoPath);
const externalLinks = site.navLinks.map((link) => ({
  ...link,
  external: /^https?:\/\//i.test(link.href),
}));
const docLinks = projects.slice(0, 4);
let portalHost = site.domain;
try {
  portalHost = new URL(site.domain).hostname;
} catch {
  portalHost = site.domain.replace(/^https?:\/\//i, "").replace(/\/+$/, "");
}
---

<BaseLayout title={site.portalTitle} description={site.portalSubtitle} accentColor={site.defaultAccent} robots={robots} structuredData={structuredData}>
  <div class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-30 h-14 border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)]/90 backdrop-blur-md">
      <div class="mx-auto flex h-full max-w-6xl items-center justify-between gap-2 px-4 sm:px-6 md:grid md:grid-cols-[1fr_auto_1fr] md:gap-4 lg:px-8">
        <a class="flex min-w-0 items-center gap-2 text-sm font-semibold text-[var(--text-primary)] no-underline md:justify-self-start" href="/" aria-label={`${site.brandName} docs home`}>
          {brandLogoExists ? (
            <img class="size-6 shrink-0 rounded-[5px] object-contain" src={site.brandLogo} alt="" width="24" height="24" />
          ) : (
            <span class="grid size-6 shrink-0 place-items-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--accent-color)]" aria-hidden="true">
              <BookOpen class="size-3.5" />
            </span>
          )}
          <span class="truncate">{site.brandName}</span>
          <span class="hidden text-xs font-normal text-[var(--border-hairline)] sm:inline" aria-hidden="true">/</span>
          <span class="hidden text-xs font-medium text-[var(--text-muted)] sm:inline">Docs</span>
        </a>

        <button
          class="ml-auto inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-xs text-[var(--text-muted)] transition-colors hover:border-[var(--text-muted)]/40 hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)] sm:w-auto sm:justify-between sm:px-2.5 md:ml-0 md:w-72 md:justify-self-center lg:w-80"
          type="button"
          data-search-trigger
          aria-label="Search documentation"
        >
          <span class="flex min-w-0 items-center gap-2">
            <Search class="size-3.5 shrink-0" aria-hidden="true" />
            <span class="hidden truncate sm:inline">Search documentation...</span>
          </span>
          <kbd class="hidden shrink-0 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-1.5 py-px font-mono text-[10px] leading-4 text-[var(--text-muted)] md:inline-flex">Ctrl K</kbd>
        </button>

        <div class="flex shrink-0 items-center gap-1 md:justify-self-end">
          <nav class="hidden items-center gap-0.5 md:flex" aria-label="External links">
            {externalLinks.map((link) => (
              <a
                class="inline-flex h-8 max-w-32 items-center gap-1 rounded-md px-2.5 text-xs text-[var(--text-muted)] no-underline transition-colors hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)]"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                <span class="truncate">{link.label}</span>
                {link.external && <ArrowUpRight class="size-3 shrink-0 opacity-55" aria-hidden="true" />}
              </a>
            ))}
          </nav>
          <span class="mx-1.5 hidden h-4 w-px bg-[var(--border-hairline)] md:block" aria-hidden="true"></span>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-auto border-t border-[var(--border-hairline)] bg-[var(--bg-surface)]/40">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-[minmax(0,1.5fr)_repeat(3,minmax(0,1fr))]">
          <div class="col-span-2 sm:col-span-3 lg:col-span-1">
            <a class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)] no-underline" href="/">
              {brandLogoExists ? (
                <img class="size-5 shrink-0 rounded-[4px] object-contain" src={site.brandLogo} alt="" width="20" height="20" />
              ) : (
                <span class="grid size-5 shrink-0 place-items-center rounded border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--accent-color)]" aria-hidden="true">
                  <BookOpen class="size-3" />
                </span>
              )}
              <span>{site.brandName}</span>
            </a>
            <p class="mt-2 max-w-xs text-xs leading-5 text-[var(--text-muted)]">
              {site.portalSubtitle}
            </p>
          </div>

          <div>
            <h2 class="text-xs font-medium text-[var(--text-primary)]">Documentation</h2>
            <ul class="mt-2.5 space-y-2 text-xs">
              {docLinks.length > 0 ? (
                docLinks.map((project) => (
                  <li>
                    <a class="text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]" href={`/${project.slug}/`}>
                      {project.title}
                    </a>
                  </li>
                ))
              ) : (
                <li>
                  <a class="text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]" href="/">
                    Portal Home
                  </a>
                </li>
              )}
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-medium text-[var(--text-primary)]">Resources</h2>
            <ul class="mt-2.5 space-y-2 text-xs">
              <li>
                <a class="text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]" href="/llms.txt">
                  LLMs Index
                </a>
              </li>
              <li>
                <a class="text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]" href="/sitemap-index.xml">
                  Sitemap
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-medium text-[var(--text-primary)]">Connect</h2>
            <ul class="mt-2.5 space-y-2 text-xs">
              {externalLinks.length > 0 ? (
                externalLinks.map((link) => (
                  <li>
                    <a
                      class="inline-flex items-center gap-1 text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]"
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      <span>{link.label}</span>
                      {link.external && <ArrowUpRight class="size-3 shrink-0 opacity-55" aria-hidden="true" />}
                    </a>
                  </li>
                ))
              ) : (
                <li>
                  <a class="text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]" href="/">
                    Documentation Hub
                  </a>
                </li>
              )}
            </ul>
          </div>
        </div>
      </div>

      <div class="border-t border-[var(--border-hairline)]">
        <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3.5 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <span>© {new Date().getFullYear()} {site.brandName}</span>
          {portalHost && <span class="font-mono text-[11px]">{portalHost}</span>}
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-search-trigger]").forEach((button) => {
    button.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("vib:open-search"));
    });
  });
</script>
