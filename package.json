{
  "name": "vib-docs-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "add-project": "node scripts/add-project.mjs",
    "export-portal": "node scripts/export-portal.mjs",
    "sync": "node scripts/sync-docs.mjs",
    "test": "tsx --test src/utils/*.test.ts",
    "lint": "tsc --noEmit",
    "verify": "npm run build && node scripts/verify-build.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "node scripts/run-astro.mjs dev --host 0.0.0.0 --port 3000",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "node scripts/run-astro.mjs build && pagefind --site dist",
    "cf:build": "npm run build",
    "pages:build": "npm run build",
    "preview": "node scripts/run-astro.mjs preview --host 0.0.0.0 --port 3000"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "astro-expressive-code": "^0.44.4",
    "gray-matter": "^4.0.3",
    "lucide-astro": "^0.556.0",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
